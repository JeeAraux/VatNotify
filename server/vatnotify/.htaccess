# VatTrackr Notify
Options -Indexes

# Die Anleitung ist index.html; auch dort als Startdatei nehmen, wo sonst nur index.php gilt
DirectoryIndex index.html

# Konfiguration und Bibliothek nie direkt ausliefern
<FilesMatch "^(config\.php|config\.sample\.php|lib\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Plugin-Dateien als Download ausliefern
<IfModule mod_mime.c>
  AddType application/octet-stream .dll
  AddType application/zip .zip
  AddType font/woff2 .woff2
</IfModule>
